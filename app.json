{
  "expo": {
    "name": "Bookmart",
    "slug": "bookmart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.bookmart.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAeHr68GlpYqHBcgZaHRnf5-psPEwMsbmI"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bookmart to access your location to find nearest books.",
          "locationWhenInUsePermission": "Allow Bookmart to access your location to find nearest books."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "851e06c6-6491-48df-814c-d7d793f87a14"
      }
    },
    "owner": "ayandip02"
  }
}